<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!-- Bu surum numarasi hicbir yerde GOSTERILMEZ ve bilerek sabittir; oyunun
       gercek surumu src/surum.h dosyasindan gelir. -->
  <assemblyIdentity type="win32" name="BorsaPatronu.Oyun" version="1.0.0.0" processorArchitecture="amd64"/>
  <description>Borsa Patronu - borsa yonetim oyunu</description>
  <!-- asInvoker: oyun yonetici yetkisi ISTEMEZ. Bunu belirtmek, Windows'un
       "kurulum programi olabilir" sezgisel kontrolunun devreye girip gereksiz
       yere UAC istemesini de onler. DPI farkindaligi BILEREK belirtilmedi:
       oyun sabit 1280x720 sanal sahneyi olcekliyor, DPI-aware yapilirsa
       yuksek DPI ekranlarda pencere fiziksel olarak kucuk kalirdi. -->
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/><!-- Windows 10 / 11 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/><!-- Windows 8.1 -->
    </application>
  </compatibility>
</assembly>
