/* ============================================================================
   Windows kaynak dosyasi - .exe'ye ikon, surum bilgisi ve manifest gomer.

   Derleme:  windres borsa_patronu.rc -O coff -o borsa_patronu_res.o
   ============================================================================ */

/* ---- IKON ----
   GLFW_ICON : raylib/GLFW pencere basligi + gorev cubugu ikonu icin bu ADI arar.
   1         : Explorer'in .exe simgesi (sayisal ID isimli olandan once gelir).  */
GLFW_ICON ICON "borsa_patronu.ico"
1         ICON "borsa_patronu.ico"

/* ---- MANIFEST (RT_MANIFEST = 24) ---- */
1 24 "borsa_patronu.manifest"

/* ---- SURUM BILGISI ----
   Bu blok olmadan dosyanin Ozellikler > Ayrintilar sekmesi BOMBOS gorunur;
   isimsiz/kimliksiz bir .exe hem kullaniciya hem sezgisel taramalara daha
   supheli gelir. SmartScreen uyarisini TEK BASINA kaldirmaz (o itibar/imza
   isidir) ama dosyanin kimligi belli olur.
   ONEMLI: yeni surumde OYUN_SURUMU sabitiyle BIRLIKTE guncelle.               */
1 VERSIONINFO
FILEVERSION    1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L   /* VOS_NT_WINDOWS32 */
FILETYPE       0x1L       /* VFT_APP          */
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Borsa Patronu"
            VALUE "FileDescription",  "Borsa Patronu - Turkce borsa yonetim simulasyonu"
            VALUE "FileVersion",      "1.1.0.0"
            VALUE "InternalName",     "borsa_patronu"
            VALUE "LegalCopyright",   "(c) 2026 Borsa Patronu"
            VALUE "OriginalFilename", "borsa_patronu.exe"
            VALUE "ProductName",      "Borsa Patronu"
            VALUE "ProductVersion",   "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
